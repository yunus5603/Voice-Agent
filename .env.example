# Gemini API key from https://aistudio.google.com/apikey (use one of the two names).
GEMINI_API_KEY=replace_me

# Text model for workshop checkpoints 00–02.
TEXT_MODEL=gemini-3.6-flash

# Live API model used by the app and checkpoints 03–06.
LIVE_MODEL=gemini-3.1-flash-live-preview

# Comma-separated browser origins allowed to open the WebSocket.
WS_ALLOWED_ORIGINS=http://localhost:8002,http://127.0.0.1:8002

# Optional limits (defaults shown).
# MAX_ACTIVE_SESSIONS=20
# MAX_WS_MESSAGE_BYTES=32768
# MAX_AUDIO_CHUNK_BYTES=16384
# LOG_LEVEL=INFO

# Workshop checkpoint 04 only: force the slow tool to fail, and set its delay.
ROOM_TOOL_FAIL=0
ROOM_TOOL_DELAY_SECONDS=5
